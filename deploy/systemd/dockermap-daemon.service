[Unit]
Description=DockerMap full-host collector
Documentation=https://github.com/Joncallim/DockerMap
After=network-online.target dockermap-docker-gateway.service
Wants=network-online.target
Requires=dockermap-docker-gateway.service

[Service]
Type=simple
User=dockermap-collector
Group=dockermap-collector
SupplementaryGroups=dockermap-gateway
WorkingDirectory=/opt/dockermap
EnvironmentFile=/etc/dockermap/dockermap.env
Environment=DOCKERMAP_DOCKER_GATEWAY_SOCKET=/run/dockermap/docker-read.sock
# This unit is the explicit native full-host profile. EnvironmentFile values
# override Environment= in systemd, so force `host` at the final exec boundary.
# Container deployments retain their separate `restricted` default.
ExecStart=/usr/bin/env DOCKERMAP_PID_NAMESPACE=host /opt/dockermap/crates/target/release/dockermap-daemon
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
# The collector reads its binaries and bounded project root but persists no
# state. Do not reopen the deployment tree after ProtectSystem=strict.
ReadOnlyPaths=/opt/dockermap
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
