{
  "$defs": {
    "ComposeMountKind": {
      "enum": [
        "bind",
        "named_volume",
        "anonymous_volume",
        "unsupported"
      ],
      "type": "string"
    },
    "ContainerMount": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComposeMountKind"
        },
        "readOnly": {
          "type": "boolean"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "target",
        "readOnly"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dependsOn": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "mounts": {
      "items": {
        "$ref": "#/$defs/ContainerMount"
      },
      "type": "array"
    },
    "name": {
      "type": "string"
    },
    "networks": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "ports": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "publishesOnUnspecifiedAddress": {
      "default": false,
      "description": "Docker reported at least one valid nonzero published port whose host\naddress is the IPv4 or IPv6 unspecified address. The collector reduces\nthe raw bind address to this closed fact before snapshot retention.",
      "type": "boolean"
    },
    "role": {
      "type": "string"
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "image",
    "status",
    "role",
    "networks",
    "ports",
    "mounts",
    "dependsOn"
  ],
  "title": "ContainerRecord",
  "type": "object"
}
