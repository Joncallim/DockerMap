{
  "$defs": {
    "HealthState": {
      "enum": [
        "ok",
        "degraded"
      ],
      "type": "string"
    },
    "RuntimeMode": {
      "enum": [
        "docker",
        "mock"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dockerReachable": {
      "type": "boolean"
    },
    "lastUpdated": {
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "$ref": "#/$defs/RuntimeMode"
    },
    "modelRevision": {
      "minLength": 1,
      "type": "string"
    },
    "snapshotVersion": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/HealthState"
    }
  },
  "required": [
    "status",
    "mode",
    "dockerReachable",
    "lastUpdated",
    "snapshotVersion",
    "modelRevision"
  ],
  "title": "HealthResponse",
  "type": "object"
}
