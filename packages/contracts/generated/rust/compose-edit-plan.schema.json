    },
    "file": {
      "type": "string"
    },
    "mountId": {
      "type": "string"
    },
    "newSource": {
      "type": [
        "string",
        "null"
      ]
    },
    "newTarget": {
      "type": [
        "string",
        "null"
      ]
    },
    "originalSource": {
      "type": [
        "string",
        "null"
      ]
    },
    "originalTarget": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "unifiedDiff": {
      "type": "string"
    },
    "willWrite": {
      "type": "boolean"
    }
  },
  "required": [
    "file",
    "service",
    "mountId",
    "originalTarget",
    "unifiedDiff",
    "diagnostics",
    "willWrite"
