{
  "$defs": {
    "ComposeDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/ComposeFileOrigin"
        },
        "severity": {
          "$ref": "#/$defs/DiagnosticSeverity"
        }
      },
      "required": [
        "id",
        "severity",
        "message",
        "origin"
      ],
      "type": "object"
    },
    "ComposeFileOrigin": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "service": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "file",
        "field"
      ],
      "type": "object"
    },
    "DiagnosticSeverity": {
