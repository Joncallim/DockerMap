{
  "$defs": {
    "GraphEdge": {
      "additionalProperties": false,
      "properties": {
        "relationship": {
          "$ref": "#/$defs/RelationshipKind"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "relationship"
      ],
      "type": "object"
    },
    "GraphNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/NodeKind"
        }
      },
      "required": [
        "id",
        "type",
        "label"
      ],
      "type": "object"
    },
    "NodeKind": {
      "enum": [
        "container",
        "network",
        "volume"
      ],
      "type": "string"
    },
    "RelationshipKind": {
      "enum": [
        "connected_to",
        "mounts"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "edges": {
      "items": {
        "$ref": "#/$defs/GraphEdge"
      },
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/GraphNode"
      },
      "type": "array"
    }
  },
  "required": [
    "nodes",
    "edges"
  ],
  "title": "GraphResponse",
  "type": "object"
}
