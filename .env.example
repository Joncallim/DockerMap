# DockerMap deployment environment
#
# Copy this to /etc/dockermap/dockermap.env and keep it readable only by the
# service user/root: API and daemon tokens are credentials. See
# docs/deployment/DOCKER.md for the complete contract and valid ranges.

# Node API (binds to 127.0.0.1 in code)
NODE_ENV=production
PORT=4000
DOCKERMAP_DAEMON_URL=http://127.0.0.1:4100
DOCKERMAP_API_TOKEN=replace-with-a-long-random-value
# Optional on loopback; defaults to DOCKERMAP_API_TOKEN when unset. Use a
# different non-empty value whenever the daemon is intentionally off-host.
DOCKERMAP_DAEMON_TOKEN=replace-with-a-separate-long-random-value
DOCKERMAP_ALLOWED_ORIGINS=https://dockermap.example.com
DOCKERMAP_ALLOW_MOCK=false
DOCKERMAP_EXPOSE_ERROR_DETAILS=false
DOCKERMAP_SSE_INTERVAL_MS=2000
DOCKERMAP_MAX_SSE_STREAMS_PER_SESSION=8
DOCKERMAP_MAX_SSE_STREAMS=128

# Browser/API authentication. DOCKERMAP_AUTH_REQUIRED=true selects trusted
# reverse-proxy forward-auth and takes precedence over DOCKERMAP_API_TOKEN.
DOCKERMAP_AUTH_REQUIRED=false
DOCKERMAP_AUTH_USER_HEADER=x-remote-user
DOCKERMAP_AUTH_NAME_HEADER=x-remote-name
DOCKERMAP_AUTH_EMAIL_HEADER=x-remote-email
DOCKERMAP_AUTH_GROUPS_HEADER=x-remote-groups
DOCKERMAP_AUTH_COOKIE=dockermap_session

# Rust daemon (keep private for review deployments)
DOCKERMAP_DAEMON_HOST=127.0.0.1
DOCKERMAP_DAEMON_PORT=4100
DOCKERMAP_PROJECT_ROOT=/opt/dockermap/project
# Optional one-label Docker Engine filter; blank means all visible resources.
# Example: com.dockermap.fixture=abc123
DOCKERMAP_DOCKER_LABEL_FILTER=
# auto, host, or restricted. Use restricted in Docker's private PID namespace.
DOCKERMAP_PID_NAMESPACE=restricted
# Only set true with a test/internal harness. This forces mock inventory even
# when Docker is reachable; it is not a deploy-time fallback setting.
DOCKERMAP_FORCE_MOCK=false
# Only set true with a non-empty daemon/API token when deliberately binding the
# daemon beyond loopback.
DOCKERMAP_ALLOW_REMOTE_DAEMON=false

# Build-time Vite setting. Empty means same-origin /api paths (the production
# image default); otherwise use one public API origin. Never put a secret here.
VITE_API_BASE_URL=
